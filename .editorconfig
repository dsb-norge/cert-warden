# EditorConfig (https://editorconfig.org) — shfmt reads this file natively.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{sh,bash,bats}]
# shfmt options (native .editorconfig support)
switch_case_indent = true

[tests/vendor/**]
# Vendored upstream code (bats helper libs) stays byte-identical to upstream so re-vendor
# diffs are reviewable — never reformat it. shfmt honors `ignore` natively; shellcheck is
# excluded via the pathspec in ci.yml's shellcheck step.
ignore = true

[*.md]
# Trailing double-space is meaningful in markdown
trim_trailing_whitespace = false

[**/az-shim/az]
switch_case_indent = true
